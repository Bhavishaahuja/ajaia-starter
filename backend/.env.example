# copy to .env (copy .env.example .env) and fill in. Never commit .env.

# SQLite locally. For Postgres paste the Supabase URL (postgres:// or postgresql:// both work).
DATABASE_URL=sqlite:///./app.db

# comma separated, no trailing slash
CORS_ORIGINS=http://localhost:5173

# uploads over this many bytes get a 413 (2 MB)
MAX_UPLOAD_BYTES=2097152
