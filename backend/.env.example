# copy to .env (copy .env.example .env) and fill in. Never commit .env.

# mock = canned answers, no key needed. live = real Claude calls.
LLM_MODE=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low, medium, high, xhigh, max. low is fast and fine for classification.
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=60

# SQLite locally. For Postgres paste the URL (postgres:// or postgresql:// both work).
DATABASE_URL=sqlite:///./app.db

# comma separated, no trailing slash
CORS_ORIGINS=http://localhost:5173

MAX_TEXT_LENGTH=5000
